APP_NAME="Dot.Forms"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production runs on one SQLite file (cPanel shared host). Leave DB_DATABASE
# unset to use database/database.sqlite; if you set it, it must be an
# absolute path to the file, NOT a database name.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# SQLite tuning (defaults shown; see config/database.php):
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=wal
# DB_SYNCHRONOUS=normal
# DB_TRANSACTION_MODE=IMMEDIATE
# PostgreSQL is NOT used in production and is not tested; the pgsql
# connection in config/database.php is only the framework's stock example.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# No websocket server on the production host: keep this null. Only set it to
# reverb (with the REVERB_* values below) where a Reverb server runs.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

DOTFORMS_TEAM_MAX_MEMBERS=10
DOTFORMS_TEAM_OWNER_ROLE=owner
DOTFORMS_UPLOAD_DISK=public
DOTFORMS_MIN_SUBMIT_SECONDS=2
DOTFORMS_QUEUE_NOTIFICATIONS=notifications
DOTFORMS_QUEUE_AI=ai

# Reverb (optional, not used in production). The builder opens a websocket
# only when VITE_REVERB_APP_KEY is set at BUILD time, so leave all of these
# commented out unless a Reverb server is running.
# REVERB_APP_ID=infodot
# REVERB_APP_KEY=infodot-key
# REVERB_APP_SECRET=infodot-secret
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Ecosystem SSO — hub URL for cross-platform token issuance
INFODOT_URL=https://infodot.app

# Ecosystem SSO: InfoDot proves handoff tokens (this app has its own database).
# INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_FORMS in InfoDot's .env, and
# INFODOT_PLATFORM_KEY must be this platform's key there. Leave the secret blank to
# accept only tokens found in this app's own database (shared-database behaviour).
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=forms
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false

# Strict-Transport-Security max-age in seconds, sent on HTTPS responses only (see config/security.php). 0 turns it off.
SECURITY_HSTS_SECONDS=15552000
